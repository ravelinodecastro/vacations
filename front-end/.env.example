# URL base do frontend
AUTH_URL=http://localhost:3000

# Keycloak — realm "lbc", porta 8080, client público "vacations"
# Para client público o secret não é validado pelo Keycloak, mas o NextAuth exige um valor.
AUTH_KEYCLOAK_ID=vacations
AUTH_KEYCLOAK_SECRET=not-required
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/lbc

# Segredo para assinar a cookie de sessão do NextAuth (gerar com: openssl rand -base64 32)
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# URL do backend Spring Boot
# Em desenvolvimento local: http://localhost:8081
# Em Docker (dentro da rede): http://back:8080
BACKEND_URL=http://localhost:8081
